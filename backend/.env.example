# Copy to .env and fill in your Gemini API key
GOOGLE_API_KEY=
USE_LLM_PARSER=true
USE_VLM_PARSER=true
GEMINI_MODEL=gemini-3.5-flash

# Or set explicit URLs (default includes opptra-frontend + localhost):
# CORS_ORIGINS=https://opptra-frontend.onrender.com,http://localhost:5173
# Or allow all: CORS_ORIGINS=*
